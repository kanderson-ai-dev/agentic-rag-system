# =============================================================
# Environment variables template (no real secrets — safe to commit)
# Copy to `.env` and fill in your own values.
# =============================================================

# --- Application ---
# APP_NAME=Agentic RAG & Knowledge Systems
# ENVIRONMENT=development
# LOG_LEVEL=INFO

# --- OpenAI / LLM (required for generation and embeddings) ---
OPENAI_API_KEY=
# CHAT_MODEL_NAME=gpt-4o-mini
# CHAT_MODEL_TEMPERATURE=0.0
# EMBEDDING_MODEL_NAME=text-embedding-3-small

# --- Self-RAG graph ---
# MAX_RETRIES=2
# RETRIEVER_TOP_K=4

# --- Checkpointing (required for human-in-the-loop) ---
# CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# --- Tracing provider (optional) ---
# Single switch for observability backends: none | langsmith | langfuse.
# `none` (default) is right for daily development and offline tests — with a
# provider selected, EVERY request is traced, including dev/manual traffic,
# so only flip it on for deliberate evidence/evaluation runs.
# TRACING_PROVIDER=none

# --- LangSmith observability (optional) ---
# Only used when TRACING_PROVIDER=langsmith. LANGCHAIN_TRACING_V2 must also be
# true; for `none`/`langfuse` the env tracing flags are forced off so nothing
# double-traces or burns the LangSmith monthly quota.
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_PROJECT=agentic-rag-system
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=

# --- Langfuse observability (optional, fallback provider) ---
# Only used when TRACING_PROVIDER=langfuse — e.g. when LangSmith quota is
# exhausted. LANGFUSE_BASE_URL is the only change needed for self-hosted
# Langfuse (e.g. http://localhost:3001).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Pinecone vector store (Phase 2, optional — falls back to local Chroma) ---
PINECONE_API_KEY=
# PINECONE_INDEX_NAME=
# PINECONE_CLOUD=
# PINECONE_REGION=

# --- Neo4j graph store (Phase 2, optional — falls back to local NetworkX) ---
# NEO4J_URI=
# NEO4J_USERNAME=
NEO4J_PASSWORD=

# --- JWT authentication (Phase 3, optional — service stays open for local quickstart) ---
# JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=30
# AUTH_USERNAME=
# AUTH_PASSWORD_HASH=

# --- Prompt registry writes ---
# When JWT auth is NOT configured, prompt-registry mutations are refused
# unless this is explicitly enabled. With JWT configured it is ignored
# (a valid token is always required for writes).
# PROMPT_REGISTRY_WRITE_ENABLED=false
